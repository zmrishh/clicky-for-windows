<Window x:Class="ClickyWindows.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">

  <Canvas x:Name="RootCanvas" Background="Transparent">

    <!-- Welcome / onboarding prompt bubble -->
    <Border x:Name="WelcomeBubble"
            Background="#3380FF"
            CornerRadius="6"
            Padding="8,4"
            Visibility="Collapsed"
            Opacity="0"
            Canvas.Left="0" Canvas.Top="0">
      <Border.Effect>
        <DropShadowEffect Color="#3380FF" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="BubbleTranslate"/>
      </Border.RenderTransform>
      <TextBlock x:Name="WelcomeText"
                 Foreground="White"
                 FontSize="11"
                 FontWeight="Medium"
                 FontFamily="Segoe UI"/>
    </Border>

    <!-- Navigation pointer bubble (pointing at detected element) -->
    <Border x:Name="NavBubble"
            Background="#3380FF"
            CornerRadius="6"
            Padding="8,6"
            MaxWidth="420"
            Visibility="Collapsed"
            Opacity="0"
            Canvas.Left="0" Canvas.Top="0">
      <Border.Effect>
        <DropShadowEffect Color="#3380FF" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
      </Border.Effect>
      <Border.RenderTransform>
        <ScaleTransform x:Name="NavBubbleScale" ScaleX="1" ScaleY="1"
                        CenterX="0" CenterY="0"/>
      </Border.RenderTransform>
      <TextBlock x:Name="NavBubbleText"
                 Foreground="White"
                 FontSize="12"
                 FontWeight="Medium"
                 FontFamily="Segoe UI"
                 TextWrapping="Wrap"
                 LineHeight="18"/>
    </Border>

    <!-- Blue triangle cursor (idle + responding) -->
    <Polygon x:Name="CursorTriangle"
             Points="0,-10 -9,8 9,8"
             Fill="#3380FF"
             Opacity="0"
             Canvas.Left="0" Canvas.Top="0">
      <Polygon.Effect>
        <DropShadowEffect x:Name="TriangleGlow"
                          Color="#3380FF" BlurRadius="10"
                          ShadowDepth="0" Opacity="0.9"/>
      </Polygon.Effect>
      <Polygon.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="TriangleScale"/>
          <RotateTransform x:Name="TriangleRotate" Angle="-35"/>
          <TranslateTransform x:Name="TriangleTranslate"/>
        </TransformGroup>
      </Polygon.RenderTransform>
    </Polygon>

    <!-- Blue waveform (listening) -->
    <Canvas x:Name="WaveformCanvas"
            Width="16" Height="14"
            Opacity="0"
            Canvas.Left="0" Canvas.Top="0">
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="WaveformTranslate"/>
      </Canvas.RenderTransform>
      <Canvas.Effect>
        <DropShadowEffect Color="#3380FF" BlurRadius="8" ShadowDepth="0" Opacity="0.65"/>
      </Canvas.Effect>
      <!-- 5 bars, heights set dynamically in code-behind -->
      <Rectangle x:Name="WaveBar0" Width="2" Height="3" Fill="#3380FF" RadiusX="1" RadiusY="1" Canvas.Left="0"  Canvas.Top="11"/>
      <Rectangle x:Name="WaveBar1" Width="2" Height="3" Fill="#3380FF" RadiusX="1" RadiusY="1" Canvas.Left="3"  Canvas.Top="11"/>
      <Rectangle x:Name="WaveBar2" Width="2" Height="3" Fill="#3380FF" RadiusX="1" RadiusY="1" Canvas.Left="6"  Canvas.Top="11"/>
      <Rectangle x:Name="WaveBar3" Width="2" Height="3" Fill="#3380FF" RadiusX="1" RadiusY="1" Canvas.Left="9"  Canvas.Top="11"/>
      <Rectangle x:Name="WaveBar4" Width="2" Height="3" Fill="#3380FF" RadiusX="1" RadiusY="1" Canvas.Left="12" Canvas.Top="11"/>
    </Canvas>

    <!-- Blue spinner (processing) -->
    <Canvas x:Name="SpinnerCanvas"
            Width="16" Height="16"
            Opacity="0"
            Canvas.Left="0" Canvas.Top="0">
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="SpinnerTranslate"/>
      </Canvas.RenderTransform>
      <Canvas.Effect>
        <DropShadowEffect Color="#3380FF" BlurRadius="8" ShadowDepth="0" Opacity="0.65"/>
      </Canvas.Effect>
      <Path x:Name="SpinnerArc"
            Stroke="#3380FF"
            StrokeThickness="2.5"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            Data="M 8,1 A 7,7 0 1 1 7.9,1">
        <Path.RenderTransform>
          <RotateTransform x:Name="SpinnerRotate" CenterX="8" CenterY="8"/>
        </Path.RenderTransform>
      </Path>
    </Canvas>

    <!-- Floating response panel — shows Claude's full reply as readable text -->
    <Border x:Name="ResponsePanel"
            MaxWidth="480"
            CornerRadius="12"
            Padding="14,10"
            Visibility="Collapsed"
            Opacity="0"
            Canvas.Left="0" Canvas.Top="0">
      <Border.Background>
        <SolidColorBrush Color="#111511" Opacity="0.88"/>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="ResponsePanelTranslate"/>
      </Border.RenderTransform>
      <ScrollViewer x:Name="ResponseScroll"
                    MaxHeight="260"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="ResponseText"
                   Foreground="#F0F0F0"
                   FontSize="14"
                   FontFamily="Segoe UI"
                   TextWrapping="Wrap"
                   LineHeight="20"/>
      </ScrollViewer>
    </Border>

    <!-- Action countdown toast — appears before executing a click/type/open -->
    <Border x:Name="ActionToast"
            CornerRadius="8"
            Padding="12,7"
            Visibility="Collapsed"
            Opacity="0"
            Canvas.Left="0" Canvas.Top="0">
      <Border.Background>
        <SolidColorBrush Color="#1A1A1A" Opacity="0.92"/>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="ActionToastTranslate"/>
      </Border.RenderTransform>
      <TextBlock x:Name="ActionToastText"
                 Foreground="#FFD060"
                 FontSize="12"
                 FontFamily="Segoe UI"
                 FontWeight="Medium"/>
    </Border>

    <!-- Onboarding video (MediaElement — HLS playback via Media Foundation) -->
    <Border x:Name="VideoContainer"
            Width="330" Height="186"
            CornerRadius="10"
            ClipToBounds="True"
            Opacity="0"
            Visibility="Collapsed"
            Canvas.Left="0" Canvas.Top="0">
      <Border.RenderTransform>
        <TranslateTransform x:Name="VideoTranslate"/>
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="6" Opacity="0.4"/>
      </Border.Effect>
      <MediaElement x:Name="OnboardingVideo"
                    LoadedBehavior="Manual"
                    UnloadedBehavior="Manual"
                    Stretch="UniformToFill"/>
    </Border>

  </Canvas>
</Window>
