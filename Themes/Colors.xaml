<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Design system matching macOS Clicky color palette -->

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="BackgroundBrush"      Color="#101211"/>
  <SolidColorBrush x:Key="Surface1Brush"         Color="#171918"/>
  <SolidColorBrush x:Key="Surface2Brush"         Color="#202221"/>
  <SolidColorBrush x:Key="Surface3Brush"         Color="#272A29"/>
  <SolidColorBrush x:Key="Surface4Brush"         Color="#2E3130"/>

  <!-- Borders -->
  <SolidColorBrush x:Key="BorderSubtleBrush"     Color="#373B39"/>
  <SolidColorBrush x:Key="BorderStrongBrush"     Color="#444947"/>

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#ECEEED"/>
  <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#ADB5B2"/>
  <SolidColorBrush x:Key="TextTertiaryBrush"     Color="#6B736F"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"     Color="White"/>

  <!-- Accent (Tailwind Blue 600) -->
  <SolidColorBrush x:Key="AccentBrush"           Color="#2563EB"/>
  <SolidColorBrush x:Key="AccentHoverBrush"      Color="#1D4ED8"/>
  <SolidColorBrush x:Key="AccentTextBrush"       Color="#60A5FA"/>

  <!-- Semantic -->
  <SolidColorBrush x:Key="SuccessBrush"          Color="#34D399"/>
  <SolidColorBrush x:Key="DestructiveBrush"      Color="#E5484D"/>

  <!-- Overlay cursor blue -->
  <SolidColorBrush x:Key="CursorBlueBrush"       Color="#3380FF"/>
  <Color x:Key="CursorBlueColor">#3380FF</Color>

  <!-- Scalar colors for code -->
  <Color x:Key="BackgroundColor">#101211</Color>
  <Color x:Key="Surface2Color">#202221</Color>
  <Color x:Key="BorderSubtleColor">#373B39</Color>

</ResourceDictionary>
